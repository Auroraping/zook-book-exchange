# 复制为 .env.local 后填入自己的值；.env.local 已在 .gitignore 中，不会进仓库
# 生产环境请直接配在平台的环境变量里，不要提交任何真实密钥

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

JWT_SECRET=replace_with_a_long_random_secret

# 是否允许通过网页 POST /api/ai/config 改写服务端密钥
# 默认关闭。只有本机开发时才设 1，公网部署务必保持关闭，否则任何访客都能换掉你的 key
AI_CONFIG_WRITABLE=0

# 每个用户（未登录按 IP 计）每天允许的 AI 调用次数，<=0 表示不限制
AI_DAILY_QUOTA=40

# 是否强制登录后才能使用 AI 助手（1=是，0=否）
AI_REQUIRE_LOGIN=0
